# Copy to .env on the VM (never commit .env). Generate secrets with:  openssl rand -hex 32

# Public address. On Azure: <dns-label>.centralindia.cloudapp.azure.com  (local testing: :80)
SITE_ADDRESS=stridebook-xxxx.centralindia.cloudapp.azure.com

# Where images are pulled from, and which build to run (git SHA or "latest").
IMAGE_PREFIX=ghcr.io/your-github-username
TAG=latest

POSTGRES_DB=stridebook
POSTGRES_USER=stridebook
# Use hex only (no special characters), it is embedded in a URL.
POSTGRES_PASSWORD=
SECRET_KEY=

# Defaults; an admin can change these later inside the app.
CLUB_NAME=Endurance Athletics Club
CLUB_SHORT=EAC

# First month the app charges fees for (YYYY-MM-01). Students who joined earlier
# owe fees from this month onward; older history stays in the register book.
TRACKING_START=2026-11-01

# From infra/provision.sh output. SAS is write-only.
BACKUP_CONTAINER_URL=https://<storageaccount>.blob.core.windows.net/backups
BACKUP_SAS=
# UTC cron; default 30 20 * * * = 02:00 IST
BACKUP_CRON=30 20 * * *
